{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devloops/invocation-record.schema.json",
  "title": "One line of state/invocations.jsonl (FR-004, FR-033, research R-13)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "session_id",
    "loop",
    "step",
    "prompt_path",
    "started_at",
    "ended_at",
    "tokens",
    "cost_usd",
    "is_error",
    "subtype",
    "permission_denials"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "loop": {
      "enum": [
        "backend-dev",
        "frontend-dev"
      ]
    },
    "step": {
      "enum": [
        "plan",
        "replan",
        "implement",
        "fix",
        "author-checks",
        "validate-ui"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "description": "The --model this call was started with (from `models` or `model`); null when none was passed and Claude Code used its default"
    },
    "milestone_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trial": {
      "type": [
        "integer",
        "null"
      ]
    },
    "prompt_path": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "num_turns": {
      "type": [
        "integer",
        "null"
      ]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "cache_creation",
        "cache_read"
      ],
      "properties": {
        "input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_creation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "description": "null values = unavailable (Edge Case)"
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ]
    },
    "is_error": {
      "type": "boolean"
    },
    "subtype": {
      "type": [
        "string",
        "null"
      ]
    },
    "permission_denials": {
      "type": "array"
    },
    "timed_out": {
      "type": "boolean",
      "default": false
    },
    "api_error_status": {
      "type": [
        "integer",
        "null"
      ]
    },
    "failure_class": {
      "enum": [
        "none",
        "work",
        "service"
      ],
      "description": "research R-19; service failures void the trial (FR-067)"
    },
    "redacted": {
      "type": "boolean",
      "description": "true if any secret values were replaced (FR-070)"
    },
    "conversation": {
      "enum": [
        "copied",
        "unavailable"
      ],
      "description": "002 FR-042: whether the call's Claude Code transcript was copied into the workspace"
    },
    "conversation_path": {
      "type": "string",
      "description": "The copy, relative to the loop directory: state/conversations/<seq>-<step>.jsonl"
    },
    "conversation_reason": {
      "enum": [
        "not-found",
        "interrupted",
        "unreadable"
      ],
      "description": "Why the conversation is unavailable"
    },
    "prompt_sources": {
      "type": "array",
      "description": "002 FR-031: the source of each prompt part of this call (research P-8)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part",
          "source",
          "path",
          "sha256"
        ],
        "properties": {
          "part": {
            "type": "string",
            "description": "common.md, steps/<step>.md, or <loop>/Loop-instructions.md"
          },
          "source": {
            "enum": [
              "packaged",
              "override"
            ]
          },
          "path": {
            "type": "string",
            "description": "The file used: kit-relative when packaged, project-relative when an override"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
