{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devloops/config.schema.json",
  "title": "Loop configuration (defaults < workspace config.json < CLI flags)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "max_trials": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "FR-005/006, D-1: trials per milestone (and per planning)"
    },
    "max_invocations_per_run": {
      "type": "integer",
      "minimum": 1,
      "default": 60,
      "description": "R-18 hard ceiling"
    },
    "invocation_timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "default": 1800
    },
    "max_budget_usd_per_invocation": {
      "type": [
        "number",
        "null"
      ],
      "default": null
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Passed as --model when set; the model of every step `models` does not name"
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "A model per step, passed as --model for that step's calls; a step not named here (or null) uses `model`. `fix_last_trial` is the model of a milestone's last allowed fix trial",
      "properties": {
        "plan": {
          "type": [
            "string",
            "null"
          ]
        },
        "replan": {
          "type": [
            "string",
            "null"
          ]
        },
        "author-checks": {
          "type": [
            "string",
            "null"
          ]
        },
        "implement": {
          "type": [
            "string",
            "null"
          ]
        },
        "fix": {
          "type": [
            "string",
            "null"
          ]
        },
        "fix_last_trial": {
          "type": [
            "string",
            "null"
          ]
        },
        "validate-ui": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "implement_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Read",
        "Edit",
        "Write",
        "Glob",
        "Grep",
        "Bash"
      ]
    },
    "unit_tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "FR-008 optional"
        },
        "command": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Overrides plan runtime.unit_test_command"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overrides for plan runtime (R-7)",
      "properties": {
        "install_command": {
          "type": "string"
        },
        "start_command": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "ready_url": {
          "type": "string"
        },
        "ready_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 120
        },
        "openapi_path": {
          "type": "string"
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "description": "frontend-dev only (FR-039, R-12)",
      "properties": {
        "base_url": {
          "type": "string"
        },
        "start_command": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "ready_url": {
          "type": "string"
        }
      }
    },
    "playwright": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headless": {
          "type": "boolean",
          "default": true,
          "description": "false shows the browser window (002 FR-017); used only when mcp_command is null"
        },
        "executable_path": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Browser binary passed as --executable-path; used only when mcp_command is null"
        },
        "mcp_command": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null,
          "description": "Explicit MCP server command, used as written. null derives npx @playwright/mcp@latest [--headless] [--executable-path <p>] (002 research P-15)"
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "full_on_stop": false,
        "light": true
      },
      "properties": {
        "full_on_stop": {
          "type": "boolean",
          "default": false,
          "description": "Also write a full dashboard when a command ends in completed or a stopped-* status; off by default: `devloops dashboard --export` writes one on demand"
        },
        "light": {
          "type": "boolean",
          "default": true,
          "description": "Write the summary page `<workspace>/dashboard.html` when a command pauses, stops, or ends; `devloops dashboard --serve` shows files and conversations"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit_per_milestone": {
          "type": "boolean",
          "default": false,
          "description": "A-6: off unless configured"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "description": "FR-070, research R-21: values redacted to *** before anything is written",
      "properties": {
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "literals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "description": "FR-035b, research R-23",
      "properties": {
        "allowed_extra": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra paths inside audited repositories that tools may write to (for example, a cache directory)"
        }
      }
    },
    "questions": {
      "enum": [
        "ask",
        "accept-suggested"
      ],
      "default": "accept-suggested",
      "description": "accept-suggested (default): the plan is approved and Claude's suggested answers are accepted automatically and flagged for review; a question without a suggestion still pauses or stops the run. ask: every plan pauses for review, and open questions stop the run for the developer (FR-053, FR-055a; `--review-plan`)"
    }
  }
}
