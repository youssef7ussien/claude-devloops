{
  "openapi": "3.0.3",
  "info": {
    "title": "Health Service API",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://127.0.0.1:8000" }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service status",
        "responses": {
          "200": {
            "description": "The service is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    }
                  }
                },
                "example": { "status": "ok" }
              }
            }
          }
        }
      }
    }
  }
}
