{
  "openapi": "3.0.3",
  "info": {
    "title": "Counter API",
    "version": "1.0.0",
    "description": "In-memory counter (COUNTER-1)."
  },
  "servers": [{ "url": "http://127.0.0.1:3000" }],
  "paths": {
    "/counter": {
      "get": {
        "operationId": "getCounter",
        "summary": "Get the current counter value",
        "responses": {
          "200": {
            "description": "Current counter value",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Counter" }
              }
            }
          }
        }
      }
    },
    "/counter/increment": {
      "post": {
        "operationId": "incrementCounter",
        "summary": "Increment the counter by one and return the new value",
        "responses": {
          "200": {
            "description": "New counter value",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Counter" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Counter": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  }
}
