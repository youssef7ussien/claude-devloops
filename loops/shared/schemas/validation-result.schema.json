{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devloops/validation-result.schema.json",
  "title": "Validation result for one trial (driver-computed; model supplies only 'criteria' for playwright)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "passed",
    "criteria",
    "contract",
    "unit_tests",
    "boundary"
  ],
  "properties": {
    "kind": {
      "enum": [
        "curl",
        "playwright"
      ]
    },
    "passed": {
      "type": "boolean",
      "description": "Computed by driver only; a criterion with no entry counts as failed (FR-068)"
    },
    "ui_url": {
      "type": "string",
      "description": "playwright only (D-2)"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "passed",
          "observed",
          "evidence"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Paths relative to trial dir; must exist; playwright requires at least one (FR-023)"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "passed",
          "command",
          "response",
          "failures"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "command": {
            "type": "string"
          },
          "response": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer"
              },
              "headers_path": {
                "type": "string"
              },
              "body_path": {
                "type": "string"
              }
            }
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "network_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "url"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "error": {
            "type": "string",
            "description": "why the request failed without a response (for example net::ERR_CONNECTION_REFUSED)"
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "unmatched_operations"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "problem": {
          "type": "string",
          "description": "frontend: why the browser's requests could not be checked (the validate-ui call never read the browser's network log); fails the contract"
        },
        "unmatched_operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "calls to operations the document does not declare (backend checks, or the browser's requests for frontend-dev); any fails the contract"
        },
        "unverified_operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "backend: documented operations no achieved milestone's check has verified; they do not fail the trial and are left out of the published outputs/openapi.json (FR-019)"
        },
        "covered_operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "backend: the documented operations this milestone's checks verified (a success status on the path really called); later milestones and publishing use them"
        }
      }
    },
    "unit_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "command": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "log_path": {
          "type": "string"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "violations"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
