#!/usr/bin/env python3
"""Entry point for the reusable development loops (see loops/README.md)."""
import os
import sys

# Keep this check above any 3.10-only syntax or import so older interpreters get a clear message.
if sys.version_info < (3, 10):
    sys.stderr.write(
        "devloops: Python 3.10 or newer is required (found %d.%d)\n" % sys.version_info[:2]
    )
    sys.exit(2)

_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_REPO_ROOT, "loops", "shared"))

from devloops import cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(sys.argv[1:]))
